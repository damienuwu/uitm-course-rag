def detect_query_language(query: str) -> str:
    """Detect if query is in Malay or English"""
    malay_keywords = [
        'apa', 'apakah', 'berapa', 'bagaimana', 'boleh', 'saya', 'yang',
        'untuk', 'syarat', 'keperluan', 'kemasukan', 'perbezaan', 'beza',
        'antara', 'dengan', 'ada', 'atau', 'dan', 'ini', 'itu',
        'sijil', 'diploma', 'sarjana', 'lepasan', 'minimum', 'kepujian'
    ]
    
    english_keywords = [
        'what', 'how', 'can', 'requirements', 'entry', 'admission',
        'difference', 'between', 'compare', 'need', 'required',
        'minimum', 'qualification', 'degree', 'bachelor', 'cgpa'
    ]
    
    query_lower = query.lower()
    
    malay_count = sum(1 for word in malay_keywords if word in query_lower)
    english_count = sum(1 for word in english_keywords if word in query_lower)
    
    return 'malay' if malay_count > english_count else 'english'


def deduplicate_documents(docs: List[str], threshold: float = 0.85) -> List[str]:
    """Remove duplicate or highly similar documents"""
    from difflib import SequenceMatcher
    
    if not docs:
        return []
    
    unique_docs = list(dict.fromkeys(docs))
    
    filtered_docs = []
    for doc in unique_docs:
        is_duplicate = False
        for existing_doc in filtered_docs:
            similarity = SequenceMatcher(None, doc, existing_doc).ratio()
            if similarity > threshold:
                is_duplicate = True
                break
        
        if not is_duplicate:
            filtered_docs.append(doc)
    
    return filtered_docs


def extract_program_code_from_query(query: str) -> Optional[str]:
    """Extract program code if mentioned in query"""
    match = re.search(r'\b[A-Z]{2,4}\d{3}\b', query.upper())
    if match:
        return match.group(0)
    return None


def is_generic_program_query(query: str, program_name: str) -> bool:
    """Check if user is asking about generic program vs specialized variant"""
    if program_name in ["Unknown", "Unspecified"]:
        return False
    
    query_lower = query.lower()
    
    comparison_keywords = [
        'perbezaan', 'beza', 'difference', 'compare', 'berbanding',
        'vs', 'versus', 'atau', 'or', 'comparison'
    ]
    is_comparison = any(kw in query_lower for kw in comparison_keywords)
    
    if is_comparison:
        return False
    
    specialized_keywords = [
        'rangkaian', 'multimedia', 'grafik', 'digital', 'forensik',
        'sistem', 'perisian', 'mobile', 'keselamatan',
        'robotik', 'data', 'awan',
        'network', 'networking', 'graphics', 'forensics', 'systems',
        'software', 'security', 'web', 'game', 'games',
        'artificial', 'intelligence', 'cloud', 'cyber', 'embedded',
        'robotics', 'data science', 'machine learning'
    ]
    
    for keyword in specialized_keywords:
        if keyword in query_lower:
            return False
    
    if program_name.lower() in query_lower:
        words_after_program = query_lower.split(program_name.lower())
        if len(words_after_program) > 1:
            remaining_text = words_after_program[1].strip()
            if len(remaining_text.split()) > 2:
                return False
        return True
    
    return True


def prioritize_generic_programs(docs: List[str], metadatas: List[Dict], 
                                  query: str, program_name: str) -> tuple:
    """
    Reorder results to prioritize generic/base programs over specialized variants.
    For example: "Diploma Sains Komputer" should come before "Diploma Sains Komputer (Rangkaian Komputer)"
    """
    if not is_generic_program_query(query, program_name):
        return docs, metadatas
    
    generic_docs = []
    generic_metas = []
    specialized_docs = []
    specialized_metas = []
    
    # Keywords that indicate specialization
    specialization_indicators = [
        'rangkaian', 'multimedia', 'grafik', 'forensik', 'keselamatan',
        'network', 'graphics', 'security', 'web', 'mobile', 'game',
        'artificial intelligence', 'data science', 'cloud', 'cyber',
        '(', ')',  # Parentheses often indicate specialization
    ]
    
    for doc, meta in zip(docs, metadatas):
        prog_name = meta.get('program_name', '').lower()
        prog_code = meta.get('program_code_uitm', '')
        
        # Check if this is a specialized program
        is_specialized = any(indicator in prog_name for indicator in specialization_indicators)
        
        # Also check if program name is much longer than base name (indicates specialization)
        base_program_lower = program_name.lower()
        if base_program_lower in prog_name:
            # If program name has significantly more words, it's likely specialized
            base_word_count = len(base_program_lower.split())
            prog_word_count = len(prog_name.split())
            if prog_word_count > base_word_count + 2:
                is_specialized = True
        
        if is_specialized:
            specialized_docs.append(doc)
            specialized_metas.append(meta)
        else:
            generic_docs.append(doc)
            generic_metas.append(meta)
    
    # Return generic programs first, then specialized
    print(f"  📊 Prioritization: {len(generic_docs)} base programs, {len(specialized_docs)} specialized programs")
    return generic_docs + specialized_docs, generic_metas + specialized_metas


def build_smart_filter(level: str, program_name: str, qual_type: Optional[str] = None, 
                       program_code: Optional[str] = None) -> Optional[Dict]:
    """Build intelligent filter for ChromaDB query"""
    conditions = []

    if program_code:
        return {"program_code_uitm": {"$eq": program_code}}

    # Always filter by level if specified
    if level and level not in ["Unspecified", "Unknown"]:
        conditions.append({"program_level": {"$eq": level}})

    # Filter by program name with contains
    if program_name and program_name not in ["Unknown", "Unspecified"]:
        base_name = program_name.replace("Diploma ", "").replace("Degree ", "").replace("Sarjana Muda ", "").strip()
        conditions.append({"program_name": {"$contains": base_name}})

    # Filter by qualification type if explicitly mentioned
    if qual_type and qual_type.upper() != "DIPLOMA":
        conditions.append({"requirement_type": {"$eq": qual_type.upper()}})

    if len(conditions) == 0:
        return None
    elif len(conditions) == 1:
        return conditions[0]
    else:
        return {"$and": conditions}


def format_context(docs: List[str], metadatas: List[Dict]) -> str:
    """Format retrieved documents into clean context"""
    formatted_sections = []
    
    for doc, meta in zip(docs, metadatas):
        section = f"""
--- {meta.get('program_name', 'Program')} ---
Code: {meta.get('program_code_uitm', 'N/A')}
Level: {meta.get('program_level', 'N/A')}

{doc}
"""
        formatted_sections.append(section.strip())
    
    return "\n\n".join(formatted_sections)


