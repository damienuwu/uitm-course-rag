# Handle line endings automatically for files detected as text 
# and perform LF normalization (transfers text as LF to repo, but may checkout as CRLF on Windows).
* text=auto

# Explicitly declare text files you want to always be LF or CRLF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
